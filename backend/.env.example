# ── Grid Sentry backend/.env.example ────────────────────────────────
# Copy to backend/.env and fill real values. NEVER commit backend/.env.

# Postgres — host is the compose service name `postgres`
DATABASE_URL=postgres://soc_admin:changeme_use_a_real_password@postgres:5432/soc_dashboard

# OpenSearch — host is the compose service name `opensearch`.
# The dev compose runs OpenSearch with the security plugin DISABLED, so the
# username/password below are ignored in dev; they exist for a secured deploy.
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=changeme

# Auth — generate two DIFFERENT secrets:  openssl rand -hex 32
# If access and refresh share a secret, a leaked access token could mint
# refresh tokens. They MUST differ.
JWT_ACCESS_SECRET=replace_me_with_openssl_rand_hex_32
JWT_REFRESH_SECRET=replace_me_with_a_DIFFERENT_openssl_rand_hex_32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# GeoIP (used from TICKET-008; not required for auth/RBAC)
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb

# Seed admin (used by `npm run seed:admin`; not read at runtime)
ADMIN_EMAIL=admin@gridsentry.local
ADMIN_PASSWORD=replace_me_before_seeding

# App
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
# Set true only when serving over HTTPS (marks the refresh cookie Secure)
COOKIE_SECURE=false

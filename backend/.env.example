# Backend API environment template
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# MongoDB Database Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gridsentry?retryWrites=true&w=majority&appName=Cluster0

# OpenSearch SIEM Node
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_32_bytes_or_more_access
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_string_32_bytes_or_more_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Ingest API & KMS Key
INGEST_API_KEY=gs_live_secret_key_2026
KMS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Admin Seed
ADMIN_EMAIL=admin@gridsentry.local
ADMIN_PASSWORD=GridSentryAdmin#2026

[
  {
    "name": "SSH Brute Force",
    "description": "Flags repeated failed SSH login attempts from the same source IP within a short window.",
    "log_source": "ssh_auth",
    "match_conditions": [
      { "field": "event_type", "operator": "equals", "value": "auth" },
      { "field": "raw_message", "operator": "contains", "value": "Failed password" }
    ],
    "threshold": 5,
    "time_window_seconds": 60,
    "severity": "high",
    "mitre_technique_id": "T1110",
    "action_on_trigger": "alert_and_block_ip",
    "is_active": true
  },
  {
    "name": "New Country Login",
    "description": "Flags a successful login from a country not seen for this source in the last 30 days.",
    "log_source": "ssh_auth",
    "match_conditions": [
      { "field": "event_type", "operator": "equals", "value": "auth" },
      { "field": "raw_message", "operator": "contains", "value": "Accepted password" }
    ],
    "threshold": 1,
    "time_window_seconds": 1,
    "severity": "medium",
    "mitre_technique_id": "T1078",
    "action_on_trigger": "alert_only",
    "is_active": true
  }
]

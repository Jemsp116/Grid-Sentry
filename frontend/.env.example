# ── Grid Sentry frontend/.env.example ───────────────────────────────
# Copy to frontend/.env. Vite only exposes vars prefixed with VITE_.

VITE_API_BASE_URL=http://localhost:4000/api

# Dev-only: set to true to skip the login screen and boot as an admin.
# Leave false for normal authenticated use.
VITE_DISABLE_AUTH=false

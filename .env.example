# ─────────────────────────────────────────────────────────────
# Grid Sentry — root environment template
#
# This root file feeds docker-compose (Postgres credentials + shared
# values). Each service also has its own .env.example (backend/, worker/,
# frontend/). Copy each to `.env` before running:
#
#   cp .env.example .env
#   cp backend/.env.example backend/.env
#   cp worker/.env.example worker/.env
#   cp frontend/.env.example frontend/.env
#
# NEVER commit real .env files — only these .example templates.
# ─────────────────────────────────────────────────────────────

# Postgres (consumed by docker-compose)
POSTGRES_USER=soc_admin
POSTGRES_PASSWORD=changeme_use_a_real_password
POSTGRES_DB=soc_dashboard
    
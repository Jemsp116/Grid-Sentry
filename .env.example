# ─────────────────────────────────────────────────────────────
# Grid Sentry — Unified Root Environment Template
#
# Copy this file to `.env` before running:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────

# MongoDB Configuration (Local or Cloud Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gridsentry?retryWrites=true&w=majority&appName=Cluster0
# For local containerized MongoDB:
# MONGODB_URI=mongodb://mongodb:27017/gridsentry

# Backend API Configuration
PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# OpenSearch SIEM Storage
OPENSEARCH_NODE=http://opensearch:9200
OPENSEARCH_USERNAME=
OPENSEARCH_PASSWORD=

# JWT Secrets (generate with: openssl rand -base64 32)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_32_bytes_or_more_access
JWT_REFRESH_SECRET=replace_with_a_different_secure_random_string_32_bytes_or_more_refresh
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Threat Intelligence (Optional)
ABUSEIPDB_API_KEY=

# External Ingest API & KMS Security Key
# WARNING: both values below are working demo defaults committed to the repo.
# Replace them before any non-local deployment.
INGEST_API_KEY=gs_live_secret_key_2026
KMS_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Frontend Client Settings
VITE_API_BASE_URL=http://localhost:4000/api
VITE_DISABLE_AUTH=false

# Detection Worker Engine Settings
POLL_INTERVAL_MS=5000

# Admin Account Seed (npm run seed:admin)
ADMIN_EMAIL=admin@gridsentry.local
ADMIN_PASSWORD=GridSentryAdmin#2026